                    <Style x:Key="DotifyPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                        <Setter Property="FontFamily" Value="{StaticResource DotifyFontFamilySemiBold}" />
                        <Setter Property="Padding" Value="16,8" />
                    </Style>

