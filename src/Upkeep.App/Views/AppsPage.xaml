<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Upkeep.App.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Upkeep.App.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource Gray50Brush}">

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Uid="AppsTitle" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Uid="AppsSubtitle" Style="{StaticResource PageSubtitleTextStyle}" MaxWidth="640" HorizontalAlignment="Left" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                Grid.Column="0"
                x:Uid="AppsSearchPlaceholder"
                Width="280"
                QueryIcon="Find"
                TextChanged="Search_TextChanged" />

            <TextBlock
                Grid.Column="1"
                Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                Style="{StaticResource CaptionTextStyle}"
                VerticalAlignment="Center" />

            <ProgressRing
                Grid.Column="3"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Width="20"
                Height="20"
                VerticalAlignment="Center" />
        </Grid>

        <InfoBar
            Grid.Row="2"
            IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="Informational"
            IsClosable="False" />

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <ListView
                ItemsSource="{x:Bind ViewModel.Apps}"
                SelectedItem="{x:Bind ViewModel.SelectedApp, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:InstalledAppDisplay">
                        <Grid ColumnSpacing="16" Padding="8,10" MinHeight="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                CornerRadius="8"
                                Background="{x:Bind Tint, Converter={StaticResource HexBrush}}">
                                <TextBlock
                                    Text="{x:Bind Initial}"
                                    FontSize="{StaticResource FontSizeSm}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Gray700Brush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{x:Bind SourceLabel}" Style="{StaticResource CaptionTextStyle}" Width="120" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind InstalledDisplay}" Style="{StaticResource CaptionTextStyle}" Width="110" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind SizeDisplay}" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" Width="90" TextAlignment="Right" VerticalAlignment="Center" />

                            <Button
                                Grid.Column="5"
                                x:Uid="AppsUninstallButton"
                                Tag="{x:Bind}"
                                Click="Uninstall_Click"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
