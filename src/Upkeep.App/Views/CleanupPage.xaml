<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Upkeep.App.Views.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource Gray50Brush}">

    <Grid Padding="32,24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Uid="CleanupTitle" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Uid="CleanupSubtitle" Style="{StaticResource PageSubtitleTextStyle}" MaxWidth="620" HorizontalAlignment="Left" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
            <StackPanel Spacing="12" HorizontalAlignment="Left">
                <TextBlock x:Uid="CleanupNotScannedMessage" Style="{StaticResource BodyTextStyle}" MaxWidth="520" TextWrapping="Wrap" />
                <Button x:Name="ScanButton" Style="{StaticResource PrimaryButtonStyle}" Click="Scan_Click" HorizontalAlignment="Left">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Primary700Color}" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Primary700Color}" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="White" />
                        <TextBlock x:Uid="CleanupScanButtonLabel" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <ProgressRing x:Name="ScanProgress" IsActive="False" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
