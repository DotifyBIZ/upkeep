<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Upkeep.App.Views.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Upkeep.App.ViewModels"
    xmlns:converters="using:Upkeep.App.Converters"
    mc:Ignorable="d"
    Background="{StaticResource Gray50Brush}">

    <Page.Resources>
        <!-- Declared per page rather than in App.xaml: the XAML compiler's second pass runs
             without a LocalAssembly reference (WMC1509), so a type from this project referenced
             from App.xaml fails to resolve with WMC0001. -->
        <converters:HexBrushConverter x:Key="HexBrush" />
    </Page.Resources>

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Uid="FilesTitle" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Uid="FilesSubtitle" Style="{StaticResource PageSubtitleTextStyle}" MaxWidth="620" HorizontalAlignment="Left" />
        </StackPanel>

        <SelectorBar x:Name="Tabs" Grid.Row="1" Margin="-12,16,0,0" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem x:Uid="FilesTabDuplicates" Tag="Duplicates" IsSelected="True" />
            <SelectorBarItem x:Uid="FilesTabLarge" Tag="Large" />
            <SelectorBarItem x:Uid="FilesTabUsage" Tag="Usage" />
        </SelectorBar>

        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="Warning"
                    IsClosable="False" />

                <!-- Where to look. Shared by all three scans, because they all answer questions
                     about the same folders. -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="FilesLookInLabel" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Width="72" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Folders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{StaticResource Gray100Brush}" CornerRadius="14" Padding="10,4" Height="28">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind}" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center" />
                                                <Button
                                                    x:Uid="FilesRemoveFolderButton"
                                                    Tag="{x:Bind}"
                                                    Click="RemoveFolder_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="2"
                                                    MinWidth="0">
                                                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource Gray500Brush}" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Uid="FilesAddFolderButton" Command="{x:Bind ViewModel.AddFolderCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock x:Uid="FilesSkippedExplanation" Style="{StaticResource CaptionTextStyle}" MaxWidth="560" VerticalAlignment="Center" />
                            <Button x:Name="ScanButton" x:Uid="FilesScanButton" Click="Scan_Click" VerticalAlignment="Center" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource SectionLabelTextStyle}" />

                <!-- Duplicates -->
                <StackPanel x:Name="DuplicatesPanel" Spacing="16">
                    <TextBlock x:Uid="FilesMatchExplanation" Style="{StaticResource CaptionTextStyle}" MaxWidth="720" HorizontalAlignment="Left" />
                    <TextBlock
                        x:Uid="FilesNoDuplicatesMessage"
                        Style="{StaticResource CaptionTextStyle}"
                        Visibility="{x:Bind ViewModel.HasNoDuplicates, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DuplicateGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:DuplicateGroupDisplay">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="20,14">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource Gray700Brush}" />
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{x:Bind Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:DuplicateFileDisplay">
                                                    <Grid Padding="20,10" ColumnSpacing="16" BorderBrush="{StaticResource Gray200Brush}" BorderThickness="0,1,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <!--  Pinned, not Auto: every row is its own Grid and WinUI has no shared size scope,
                                                                  so an Auto column is measured per row and the values never line up. The keeper
                                                                  tag is absent on most rows, which would shift the date column on the rest.  -->
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="96" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Path}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind ModifiedDisplay}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border
                                                            Grid.Column="3"
                                                            Visibility="{x:Bind IsKeeper}"
                                                            Background="{StaticResource SuccessSurfaceBrush}"
                                                            CornerRadius="10"
                                                            Padding="8,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                            <TextBlock x:Uid="FilesKeepingTagText" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource SuccessTextBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Large and forgotten files -->
                <StackPanel x:Name="LargePanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock
                        x:Uid="FilesNoLargeFilesMessage"
                        Style="{StaticResource CaptionTextStyle}"
                        Visibility="{x:Bind ViewModel.HasNoLargeFiles, Mode=OneWay}" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.LargeFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:LargeFileDisplay">
                                    <Grid Padding="20,12" ColumnSpacing="16" BorderBrush="{StaticResource Gray200Brush}" BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <!--  Pinned, not Auto: each row is its own Grid and WinUI has no shared size scope, so
                                                  an Auto column sizes to that row alone. "Large" and "Not opened in two years" are
                                                  different widths, which walked the date and size columns left and right per row.  -->
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Reason}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind ModifiedDisplay}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind SizeDisplay}" TextAlignment="Right" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Disk usage -->
                <StackPanel x:Name="UsagePanel" Spacing="16" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="{x:Bind ViewModel.UsageBreadcrumb, Mode=OneWay}" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.UsageSummary, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16" VerticalAlignment="Top">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TreemapRects}" Width="560" Height="468">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:UsageRectDisplay">
                                        <Border
                                            Width="{x:Bind Width}"
                                            Height="{x:Bind Height}"
                                            Margin="1"
                                            CornerRadius="4"
                                            Background="{x:Bind Fill, Converter={StaticResource HexBrush}}">
                                            <StackPanel Margin="8,6" Visibility="{x:Bind ShowLabel}">
                                                <TextBlock Text="{x:Bind Name}" FontSize="{StaticResource FontSizeXs}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind SizeDisplay}" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray900Brush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="20" Width="300" VerticalAlignment="Top">
                            <StackPanel Spacing="12">
                                <TextBlock x:Uid="FilesUsageLargestHeader" Style="{StaticResource SectionLabelTextStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.UsageRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:UsageRowDisplay">
                                            <StackPanel Spacing="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeDisplay}" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" />
                                                </Grid>
                                                <ProgressBar Value="{x:Bind Share}" Maximum="1" Height="4" CornerRadius="2" Foreground="{StaticResource Secondary600Brush}" Background="{StaticResource Gray100Brush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind ViewModel.UsageUnreadableNote, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- What is selected, and the two ways to act on it. -->
        <Border
            x:Name="ActionBar"
            Grid.Row="3"
            Margin="-32,16,-32,-24"
            Padding="32,16"
            Background="White"
            BorderBrush="{StaticResource Gray200Brush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" Style="{StaticResource SectionLabelTextStyle}" />
                    <TextBlock x:Uid="FilesQuarantineNote" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <CheckBox
                    Grid.Column="1"
                    x:Uid="FilesDeletePermanentlyLabel"
                    IsChecked="{x:Bind ViewModel.DeletePermanently, Mode=TwoWay}"
                    VerticalAlignment="Center" />

                <Button
                    Grid.Column="2"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}"
                    Click="Remove_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Primary700Color}" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Primary700Color}" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                    <TextBlock x:Uid="FilesQuarantineButtonLabel" Foreground="White" FontWeight="SemiBold" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
