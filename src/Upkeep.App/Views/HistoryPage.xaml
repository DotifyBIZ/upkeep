<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Upkeep.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Upkeep.App.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource Gray50Brush}">

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Uid="HistoryTitle" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Uid="HistorySubtitle" Style="{StaticResource PageSubtitleTextStyle}" MaxWidth="640" HorizontalAlignment="Left" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="Informational"
            IsClosable="False" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Uid="HistoryEmptyMessage"
                    Style="{StaticResource CaptionTextStyle}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:HistorySessionDisplay">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{x:Bind KindLabel}"
                                                FontSize="{StaticResource FontSizeSm}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource Gray900Brush}" />
                                            <TextBlock Text="{x:Bind WhenDisplay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind ChangesDisplay}" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock
                                                Text="{x:Bind FreedDisplay}"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Visibility="{x:Bind HasFreedDisplay}" />
                                        </StackPanel>

                                        <TextBlock
                                            Text="{x:Bind RestorePointNote}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            TextWrapping="Wrap"
                                            MaxWidth="620"
                                            HorizontalAlignment="Left"
                                            Visibility="{x:Bind HasRestorePointNote}" />

                                        <TextBlock
                                            Text="{x:Bind UnfinishedNote}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Visibility="{x:Bind HasUnfinishedNote}" />

                                        <TextBlock
                                            Text="{x:Bind RevertedNote}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Foreground="{StaticResource Secondary600Brush}"
                                            Visibility="{x:Bind HasRevertedNote}" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        x:Uid="HistoryRevertButton"
                                        Click="Revert_Click"
                                        IsEnabled="{x:Bind CanRevert}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing Grid.Row="3" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Left" />
    </Grid>
</Page>
