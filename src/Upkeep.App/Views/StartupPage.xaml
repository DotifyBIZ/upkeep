<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Upkeep.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Upkeep.App.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource Gray50Brush}">

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Uid="StartupTitle" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Uid="StartupSubtitle" Style="{StaticResource PageSubtitleTextStyle}" MaxWidth="640" HorizontalAlignment="Left" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="Warning"
            IsClosable="False" />

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0" VerticalAlignment="Top">
            <StackPanel>
                <Grid Padding="20,12" ColumnSpacing="16" Background="{StaticResource Gray50Brush}" BorderBrush="{StaticResource Gray200Brush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Uid="StartupColumnName" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="1" x:Uid="StartupColumnSource" Style="{StaticResource CaptionTextStyle}" Width="260" />
                    <TextBlock Grid.Column="2" x:Uid="StartupColumnEnabled" Style="{StaticResource CaptionTextStyle}" Width="110" />
                </Grid>

                <TextBlock
                    x:Uid="StartupEmptyMessage"
                    Style="{StaticResource CaptionTextStyle}"
                    Margin="20,16"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StartupItemDisplay">
                            <Grid Padding="20,10" ColumnSpacing="16" BorderBrush="{StaticResource Gray200Brush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind DisabledAtDisplay}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Width="260" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind SourceLabel}" Style="{StaticResource BodyTextStyle}" FontSize="13" TextWrapping="Wrap" />
                                    <FontIcon
                                        Glyph="&#xE72E;"
                                        FontSize="12"
                                        Foreground="{StaticResource Secondary600Brush}"
                                        Visibility="{x:Bind RequiresElevation}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="2"
                                    Width="110"
                                    OnContent=""
                                    OffContent=""
                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                    IsEnabled="{x:Bind CanToggle}"
                                    Toggled="OnStartupItemToggled"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" />
            <TextBlock x:Uid="StartupToggleNote" Style="{StaticResource CaptionTextStyle}" MaxWidth="720" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
